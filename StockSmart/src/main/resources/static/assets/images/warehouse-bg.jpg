<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e1b4b" />
      <stop offset="100%" stop-color="#312e81" />
    </linearGradient>
    <linearGradient id="rackGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#475569" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>
    <linearGradient id="boxGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>
    <linearGradient id="boxGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8b5cf6" />
      <stop offset="100%" stop-color="#6d28d9" />
    </linearGradient>
    <linearGradient id="boxGrad3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>
  </defs>

  <!-- Deep warehouse atmospheric background -->
  <rect width="1200" height="800" fill="url(#skyGrad)" />
  
  <!-- Perspective Warehouse Floor -->
  <polygon points="0,500 1200,500 1200,800 0,800" fill="#090d16" />
  
  <!-- Floor Grid Lines -->
  <line x1="600" y1="500" x2="100" y2="800" stroke="#1e293b" stroke-width="2" />
  <line x1="600" y1="500" x2="350" y2="800" stroke="#1e293b" stroke-width="2" />
  <line x1="600" y1="500" x2="600" y2="800" stroke="#1e293b" stroke-width="2" />
  <line x1="600" y1="500" x2="850" y2="800" stroke="#1e293b" stroke-width="2" />
  <line x1="600" y1="500" x2="1100" y2="800" stroke="#1e293b" stroke-width="2" />
  
  <!-- Massive High-Bay Storage Racks Left -->
  <rect x="50" y="80" width="30" height="520" fill="url(#rackGrad)" />
  <rect x="180" y="80" width="30" height="520" fill="url(#rackGrad)" />
  <rect x="310" y="80" width="30" height="520" fill="url(#rackGrad)" />
  
  <!-- Beams -->
  <line x1="40" y1="180" x2="350" y2="180" stroke="#f97316" stroke-width="12" />
  <line x1="40" y1="290" x2="350" y2="290" stroke="#f97316" stroke-width="12" />
  <line x1="40" y1="400" x2="350" y2="400" stroke="#f97316" stroke-width="12" />
  <line x1="40" y1="510" x2="350" y2="510" stroke="#f97316" stroke-width="12" />
  
  <!-- Pallets & Inventory Boxes on Racks -->
  <rect x="90" y="120" width="80" height="55" rx="4" fill="url(#boxGrad1)" />
  <rect x="220" y="125" width="80" height="50" rx="4" fill="url(#boxGrad2)" />
  
  <rect x="90" y="235" width="75" height="50" rx="4" fill="url(#boxGrad3)" />
  <rect x="225" y="230" width="85" height="55" rx="4" fill="url(#boxGrad1)" />

  <rect x="85" y="340" width="85" height="55" rx="4" fill="url(#boxGrad2)" />
  <rect x="220" y="345" width="80" height="50" rx="4" fill="url(#boxGrad3)" />

  <!-- Overhead Industrial Lights -->
  <ellipse cx="300" cy="50" rx="60" ry="10" fill="#a78bfa" opacity="0.4" />
  <ellipse cx="600" cy="50" rx="60" ry="10" fill="#a78bfa" opacity="0.3" />
  <ellipse cx="900" cy="50" rx="60" ry="10" fill="#a78bfa" opacity="0.2" />
  
  <!-- Ambient Warehouse Glow -->
  <circle cx="600" cy="450" r="300" fill="#6d28d9" opacity="0.08" />
</svg>
